#!/usr/bin/env python3
"""Inspect local Codex session history, live activity, and event streams."""

from __future__ import annotations

import argparse
import hashlib
import gzip
import json
import os
import re
import shutil
import sqlite3
import stat
import subprocess
import sys
import time
from collections import deque
from contextlib import contextmanager
from datetime import datetime, timezone
from pathlib import Path

__version__ = "2.6.1"

_DEFAULT_CODEX_HOME = os.environ.get("CODEX_HOME") or str(Path.home() / ".codex")
DEFAULT_SESSIONS_DIR = str(Path(_DEFAULT_CODEX_HOME) / "sessions")
DEFAULT_ARCHIVED_DIR = str(Path(_DEFAULT_CODEX_HOME) / "archived_sessions")
DEFAULT_CODEX_LOG_DB = Path(_DEFAULT_CODEX_HOME) / "logs_2.sqlite"
SESSION_INDEX_FILE = "session_index.jsonl"
SESSION_INFO_SCAN_LIMIT = 2000

UUID_RE = re.compile(
    r"[0-9a-fA-F]{8}-"
    r"[0-9a-fA-F]{4}-"
    r"[0-9a-fA-F]{4}-"
    r"[0-9a-fA-F]{4}-"
    r"[0-9a-fA-F]{12}"
)
DURATION_RE = re.compile(r"^(?P<value>\d+)(?P<unit>[smhd])$")

VALID_COLUMNS = ("live", "age", "status", "agent_type", "id", "cwd", "repo", "path", "title")
VIEW_COLUMNS = {
    "summary": ("age", "title"),
    "ops": ("live", "age", "status", "agent_type", "id", "cwd", "title"),
    "paths": ("live", "age", "status", "agent_type", "id", "cwd", "repo", "path", "title"),
}
COLUMN_LABELS = {
    "live": "Live",
    "age": "Age",
    "status": "Status",
    "agent_type": "Agent",
    "id": "Session",
    "cwd": "CWD",
    "repo": "Repo",
    "path": "Path",
    "title": "Title",
}
STATUS_ORDER = {"running": 0, "completed": 1, "stale": 2}
SOURCE_CHOICES = ("live", "all")
STATUS_CHOICES = tuple(STATUS_ORDER.keys())
DURATION_UNITS = {"s": 1, "m": 60, "h": 3600, "d": 86400}


@contextmanager
def open_session_text(path: Path):
    """Open a Codex session file as a text stream."""

    name = path.name
    if name.endswith(".jsonl.gz"):
        f = gzip.open(path, "rt", encoding="utf-8", errors="replace")
        try:
            yield f
        finally:
            f.close()
        return

    if name.endswith(".jsonl.zst"):
        proc = subprocess.Popen(
            ["zstd", "-dc", str(path)],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            encoding="utf-8",
            errors="replace",
        )
        try:
            assert proc.stdout is not None
            yield proc.stdout
        finally:
            try:
                if proc.stdout:
                    proc.stdout.close()
            finally:
                try:
                    proc.terminate()
                except Exception:
                    pass
                try:
                    proc.wait(timeout=1)
                except Exception:
                    pass
        return

    with path.open("r", encoding="utf-8", errors="replace") as f:
        yield f


def parse_iso(value: str) -> datetime | None:
    if not value:
        return None
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00"))
    except Exception:
        return None


def parse_duration(value: str) -> int:
    match = DURATION_RE.fullmatch(value.strip().lower())
    if not match:
        raise argparse.ArgumentTypeError(
            f"Invalid duration {value!r}. Use Ns, Nm, Nh, or Nd."
        )
    return int(match.group("value")) * DURATION_UNITS[match.group("unit")]


def parse_columns(value: str) -> tuple[str, ...]:
    columns = []
    for raw in value.split(","):
        column = raw.strip().lower()
        if not column:
            continue
        if column not in VALID_COLUMNS:
            allowed = ", ".join(VALID_COLUMNS)
            raise argparse.ArgumentTypeError(
                f"Invalid column {column!r}. Allowed columns: {allowed}."
            )
        if column not in columns:
            columns.append(column)
    if not columns:
        raise argparse.ArgumentTypeError("At least one column is required.")
    return tuple(columns)


def extract_id_from_filename(name: str) -> str:
    match = UUID_RE.search(name)
    if not match:
        return ""
    return match.group(0)


def extract_title_from_message(message: str) -> str:
    lines = [line.strip() for line in message.splitlines()]
    for index, line in enumerate(lines):
        if "My request for Codex" in line:
            for candidate in lines[index + 1 :]:
                if candidate:
                    return candidate
            return ""
    for line in lines:
        if line and not line.startswith("#"):
            return line
    return ""


def looks_like_local_path(value: object) -> bool:
    if not isinstance(value, str):
        return False
    value = value.strip()
    return value.startswith("/") and len(value) > 1


def find_path_hint(node: object) -> str:
    if isinstance(node, dict):
        for key in ("cwd", "workdir", "workspace", "project_path", "root_path"):
            value = node.get(key)
            if looks_like_local_path(value):
                return str(value).strip()
        for key, value in node.items():
            key_norm = str(key).casefold()
            if any(token in key_norm for token in ("cwd", "workdir", "workspace", "project", "root")) and looks_like_local_path(value):
                return str(value).strip()
        for value in node.values():
            found = find_path_hint(value)
            if found:
                return found
    elif isinstance(node, list):
        for value in node:
            found = find_path_hint(value)
            if found:
                return found
    return ""


def derive_repo_hint(cwd: str, git_meta: object) -> str:
    if isinstance(git_meta, dict):
        repo_url = str(git_meta.get("repository_url") or "").strip()
        if repo_url:
            return repo_url
    if cwd:
        current = Path(cwd)
        for candidate in (current, *current.parents):
            if (candidate / ".git").exists():
                return str(candidate)
    return ""


def source_subagent_spawn(source: object) -> dict:
    if not isinstance(source, dict):
        return {}
    subagent = source.get("subagent")
    if not isinstance(subagent, dict):
        return {}
    thread_spawn = subagent.get("thread_spawn")
    return thread_spawn if isinstance(thread_spawn, dict) else {}


def extract_agent_type(meta: dict) -> str:
    agent_role = str(meta.get("agent_role") or "").strip()
    if agent_role:
        return agent_role

    spawn = source_subagent_spawn(meta.get("source"))
    spawn_role = str(spawn.get("agent_role") or "").strip()
    if spawn_role:
        return spawn_role

    if meta.get("thread_source") == "subagent" or spawn:
        return "subagent"
    if meta.get("thread_source") == "user" or meta.get("source") == "cli":
        return "user"
    return ""


def extract_agent_nickname(meta: dict) -> str:
    nickname = str(meta.get("agent_nickname") or "").strip()
    if nickname:
        return nickname
    spawn = source_subagent_spawn(meta.get("source"))
    return str(spawn.get("agent_nickname") or "").strip()


def format_age(ts: datetime, now: datetime) -> str:
    seconds = max(0, int((now - ts).total_seconds()))
    if seconds < 60:
        return f"{seconds}s"
    if seconds < 3600:
        return f"{seconds // 60}m"
    if seconds < 86400:
        return f"{seconds // 3600}h"
    return f"{seconds // 86400}d"


def truncate(text: str, max_len: int) -> str:
    if max_len <= 0 or len(text) <= max_len:
        return text
    return text[: max_len - 1].rstrip() + "…"


def build_source_roots(source: str) -> list[tuple[str, Path]]:
    roots = [("live", Path(DEFAULT_SESSIONS_DIR))]
    if source == "all":
        roots.append(("archived", Path(DEFAULT_ARCHIVED_DIR)))
    return roots


def load_session_index_entries(source_roots: list[tuple[str, Path]]) -> dict[str, dict[str, str]]:
    entries: dict[str, dict[str, str]] = {}
    codex_homes = {str(root.resolve().parent) for _, root in source_roots}
    for codex_home in codex_homes:
        index_path = Path(codex_home) / SESSION_INDEX_FILE
        if not index_path.exists():
            continue
        try:
            with index_path.open("r", encoding="utf-8", errors="replace") as f:
                for line in f:
                    try:
                        obj = json.loads(line)
                    except Exception:
                        continue
                    thread_id = str(obj.get("id") or "").strip()
                    if not thread_id:
                        continue
                    entries[thread_id] = {
                        "thread_name": str(obj.get("thread_name") or "").strip(),
                        "updated_at": str(obj.get("updated_at") or "").strip(),
                    }
        except OSError:
            continue
    return entries


def iter_session_paths(source_roots: list[tuple[str, Path]]):
    patterns = ("*.jsonl", "*.jsonl.gz", "*.jsonl.zst")
    for source_name, root in source_roots:
        if not root.exists():
            continue
        for pattern in patterns:
            for path in root.rglob(pattern):
                if path.is_file():
                    yield source_name, path


def read_last_json_line(path: Path) -> str | None:
    if path.name.endswith(".jsonl"):
        try:
            with path.open("rb") as f:
                f.seek(0, os.SEEK_END)
                end = f.tell()
                if end <= 0:
                    return None

                pos = end - 1
                while pos >= 0:
                    f.seek(pos)
                    if f.read(1) not in {b"\n", b"\r"}:
                        break
                    pos -= 1

                if pos < 0:
                    return None

                start = pos
                while start >= 0:
                    f.seek(start)
                    if f.read(1) == b"\n":
                        start += 1
                        break
                    start -= 1

                if start < 0:
                    start = 0

                f.seek(start)
                raw = f.read(pos - start + 1)
        except OSError:
            return None
        return raw.decode("utf-8", errors="replace").strip() or None

    tail = deque(maxlen=1)
    try:
        with open_session_text(path) as f:
            for line in f:
                line = line.strip()
                if line:
                    tail.append(line)
    except OSError:
        return None
    return tail[0] if tail else None


def tail_session_event(path: Path) -> tuple[datetime | None, bool]:
    raw = read_last_json_line(path)
    if not raw:
        return None, False
    try:
        obj = json.loads(raw)
    except Exception:
        return None, False
    payload = obj.get("payload") or {}
    last_ts = parse_iso(obj.get("timestamp") or "")
    completed = obj.get("type") == "event_msg" and payload.get("type") == "task_complete"
    return last_ts, completed


def session_info(
    path: Path,
    source_name: str,
    index_entries: dict[str, dict[str, str]] | None = None,
) -> dict:
    started_at = None
    session_id = ""
    preview = ""
    cwd = ""
    repo = ""
    agent_type = ""
    agent_nickname = ""
    try:
        with open_session_text(path) as f:
            for line_number, line in enumerate(f, start=1):
                if line_number > SESSION_INFO_SCAN_LIMIT:
                    break
                try:
                    obj = json.loads(line)
                except Exception:
                    continue
                payload = obj.get("payload") or {}
                if obj.get("type") == "session_meta":
                    if not session_id:
                        session_id = (
                            payload.get("id")
                            or payload.get("session_id")
                            or payload.get("sessionId")
                            or ""
                        )
                    if not started_at:
                        started_at = parse_iso(payload.get("timestamp") or obj.get("timestamp") or "")
                    if not cwd:
                        cwd = find_path_hint(payload)
                    if not repo:
                        repo = derive_repo_hint(cwd, payload.get("git"))
                    if not agent_type:
                        agent_type = extract_agent_type(payload)
                    if not agent_nickname:
                        agent_nickname = extract_agent_nickname(payload)
                elif obj.get("type") == "event_msg":
                    if payload.get("type") == "user_message" and not preview:
                        preview = extract_title_from_message(payload.get("message") or "")
                    if not cwd:
                        cwd = find_path_hint(payload)
                    if not repo:
                        repo = derive_repo_hint(cwd, payload.get("git"))
                if started_at and session_id and preview and cwd and repo and agent_type:
                    break
    except Exception:
        pass

    last_activity_at = datetime.fromtimestamp(path.stat().st_mtime, tz=timezone.utc)
    if not session_id:
        session_id = extract_id_from_filename(path.name)
    index_entry = (index_entries or {}).get(session_id, {})
    index_updated_at = parse_iso(index_entry.get("updated_at") or "") if index_entry else None
    if path.stat().st_size == 0 and index_updated_at is not None:
        last_activity_at = index_updated_at
    if not started_at:
        started_at = index_updated_at or last_activity_at
    thread_name = str(index_entry.get("thread_name") or "")
    title = thread_name or preview or "(untitled session)"
    recovery_kind = ""
    if path.stat().st_size == 0:
        recovery_kind = "zero_byte"
    elif thread_name and not preview and not cwd and not repo:
        recovery_kind = "metadata_empty"
    return {
        "id": session_id,
        "title": title,
        "thread_name": thread_name,
        "preview": preview,
        "cwd": cwd,
        "repo": repo,
        "agent_type": agent_type,
        "agent_nickname": agent_nickname,
        "source": source_name,
        "path": path,
        "started_at": started_at,
        "last_activity_at": last_activity_at,
        "completed": False,
        "status": "stale",
        "age": "",
        "live_age": "",
        "recovery_kind": recovery_kind,
    }


def matches_query(
    record: dict,
    query: str | None,
    regexes: list[re.Pattern[str]],
    cwd_query: str | None,
    cwd_regexes: list[re.Pattern[str]],
    repo_query: str | None,
    repo_regexes: list[re.Pattern[str]],
) -> bool:
    haystacks = (
        record.get("title") or "",
        record.get("thread_name") or "",
        record.get("preview") or "",
        record.get("id") or "",
    )
    cwd_value = record.get("cwd") or ""
    repo_value = record.get("repo") or ""
    if query:
        query_norm = query.casefold()
        if not any(text and query_norm in text.casefold() for text in haystacks):
            return False
    if regexes:
        if not any(text and any(pattern.search(text) for pattern in regexes) for text in haystacks):
            return False
    if cwd_query and cwd_query.casefold() not in cwd_value.casefold():
        return False
    if cwd_regexes and not any(pattern.search(cwd_value) for pattern in cwd_regexes):
        return False
    if repo_query and repo_query.casefold() not in repo_value.casefold():
        return False
    if repo_regexes and not any(pattern.search(repo_value) for pattern in repo_regexes):
        return False
    return True


def index_entry_matches(
    session_id: str,
    entry: dict[str, str],
    query: str | None,
    regexes: list[re.Pattern[str]],
) -> bool:
    haystacks = (session_id, str(entry.get("thread_name") or ""))
    if query:
        query_norm = query.casefold()
        if not any(text and query_norm in text.casefold() for text in haystacks):
            return False
    if regexes:
        if not any(text and any(pattern.search(text) for pattern in regexes) for text in haystacks):
            return False
    return True


def build_index_only_record(session_id: str, entry: dict[str, str]) -> dict | None:
    updated_at = parse_iso(entry.get("updated_at") or "")
    if updated_at is None:
        return None
    return {
        "id": session_id,
        "title": str(entry.get("thread_name") or "") or "(untitled session)",
        "thread_name": str(entry.get("thread_name") or ""),
        "preview": "",
        "cwd": "",
        "repo": "",
        "agent_type": "",
        "agent_nickname": "",
        "source": "index",
        "path": None,
        "started_at": updated_at,
        "last_activity_at": updated_at,
        "completed": False,
        "status": "stale",
        "age": "",
        "live_age": "",
        "recovery_kind": "index_only",
    }


def session_text_matches(
    path: Path,
    fulltext_query: str | None,
    fulltext_regexes: list[re.Pattern[str]],
) -> bool:
    if not fulltext_query and not fulltext_regexes:
        return True

    query_norm = fulltext_query.casefold() if fulltext_query else None
    query_hit = query_norm is None
    regex_hit = not fulltext_regexes

    try:
        with open_session_text(path) as f:
            for line in f:
                if not query_hit and query_norm and query_norm in line.casefold():
                    query_hit = True
                if not regex_hit and any(pattern.search(line) for pattern in fulltext_regexes):
                    regex_hit = True
                if query_hit and regex_hit:
                    return True
    except OSError:
        return False
    return False


def rg_file_matches(
    source_roots: list[tuple[str, Path]],
    fulltext_query: str | None,
    fulltext_regexes: list[re.Pattern[str]],
) -> set[Path] | None:
    if not fulltext_query and not fulltext_regexes:
        return None
    if shutil.which("rg") is None:
        return None

    roots = [str(root) for _, root in source_roots if root.exists()]
    if not roots:
        return set()

    def run_rg(args: list[str]) -> set[Path] | None:
        try:
            proc = subprocess.run(
                args,
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
                check=False,
            )
        except OSError:
            return None
        # rg exit code: 0 match, 1 no match, 2 error
        if proc.returncode not in {0, 1}:
            return None
        lines = [line.strip() for line in proc.stdout.splitlines() if line.strip()]
        return {Path(line).resolve() for line in lines}

    matched: set[Path] | None = None
    if fulltext_query:
        query_args = [
            "rg",
            "-l",
            "-i",
            "--fixed-strings",
            "--search-zip",
            fulltext_query,
            *roots,
        ]
        query_set = run_rg(query_args)
        if query_set is None:
            return None
        matched = query_set

    if fulltext_regexes:
        regex_args = ["rg", "-l", "-i", "--search-zip"]
        for pattern in fulltext_regexes:
            regex_args.extend(["-e", pattern.pattern])
        regex_args.extend(roots)
        regex_set = run_rg(regex_args)
        if regex_set is None:
            return None
        matched = regex_set if matched is None else matched.intersection(regex_set)

    return matched if matched is not None else set()


def session_status(record: dict, now: datetime, running_window_seconds: int) -> str:
    if record["completed"]:
        return "completed"
    if (now - record["last_activity_at"]).total_seconds() <= running_window_seconds:
        return "running"
    return "stale"


def collect_sessions(
    source: str,
    include_untitled: bool,
    query: str | None,
    regexes: list[re.Pattern[str]],
    cwd_query: str | None,
    cwd_regexes: list[re.Pattern[str]],
    repo_query: str | None,
    repo_regexes: list[re.Pattern[str]],
    fulltext_query: str | None,
    fulltext_regexes: list[re.Pattern[str]],
    now: datetime,
    running_window_seconds: int,
    status_filter: set[str] | None = None,
    active_within_seconds: int | None = None,
) -> list[dict]:
    source_roots = build_source_roots(source)
    index_entries = load_session_index_entries(source_roots)
    rg_matches = rg_file_matches(source_roots, fulltext_query, fulltext_regexes)
    indexed_candidate_ids: set[str] | None = None
    if (query or regexes) and not any((cwd_query, cwd_regexes, repo_query, repo_regexes, fulltext_query, fulltext_regexes)):
        matched_ids = {
            session_id
            for session_id, entry in index_entries.items()
            if index_entry_matches(session_id, entry, query, regexes)
        }
        if matched_ids:
            indexed_candidate_ids = matched_ids
    records: list[dict] = []
    seen_ids: set[str] = set()
    for source_name, path in iter_session_paths(source_roots):
        session_id_from_name = extract_id_from_filename(path.name)
        try:
            path_stat = path.stat()
        except OSError:
            continue
        path_last_activity_at = datetime.fromtimestamp(path_stat.st_mtime, tz=timezone.utc)
        path_live_seconds = (now - path_last_activity_at).total_seconds()
        if active_within_seconds is not None and path_live_seconds > active_within_seconds:
            continue
        if status_filter == {"running"} and path_live_seconds > running_window_seconds:
            continue
        if indexed_candidate_ids is not None and session_id_from_name:
            if session_id_from_name in index_entries and session_id_from_name not in indexed_candidate_ids:
                continue
        record = session_info(path, source_name, index_entries=index_entries)
        if not include_untitled and record["title"] == "(untitled session)":
            continue
        if not matches_query(record, query, regexes, cwd_query, cwd_regexes, repo_query, repo_regexes):
            continue
        if fulltext_query or fulltext_regexes:
            path_resolved = path.resolve()
            if rg_matches is not None:
                if path_resolved in rg_matches:
                    pass
                elif path.name.endswith(".jsonl.zst"):
                    if not session_text_matches(path, fulltext_query, fulltext_regexes):
                        continue
                else:
                    continue
            elif not session_text_matches(path, fulltext_query, fulltext_regexes):
                continue
        _, record["completed"] = tail_session_event(path)
        record["status"] = session_status(record, now, running_window_seconds)
        live_seconds = (now - record["last_activity_at"]).total_seconds()
        if status_filter is not None and record["status"] not in status_filter:
            continue
        record["age"] = format_age(record["started_at"], now)
        record["live_age"] = format_age(record["last_activity_at"], now)
        records.append(record)
        if record["id"]:
            seen_ids.add(record["id"])

    for session_id, entry in index_entries.items():
        if session_id in seen_ids:
            continue
        if indexed_candidate_ids is not None and session_id not in indexed_candidate_ids:
            continue
        record = build_index_only_record(session_id, entry)
        if record is None:
            continue
        if not include_untitled and record["title"] == "(untitled session)":
            continue
        if not matches_query(record, query, regexes, cwd_query, cwd_regexes, repo_query, repo_regexes):
            continue
        if fulltext_query or fulltext_regexes:
            continue
        if status_filter == {"running"}:
            continue
        if status_filter is not None and record["status"] not in status_filter:
            continue
        live_seconds = (now - record["last_activity_at"]).total_seconds()
        if active_within_seconds is not None and live_seconds > active_within_seconds:
            continue
        record["age"] = format_age(record["started_at"], now)
        record["live_age"] = format_age(record["last_activity_at"], now)
        records.append(record)
    return records


def sort_records(records: list[dict], sort_key: str) -> None:
    if sort_key == "start":
        records.sort(
            key=lambda record: (
                -(record["started_at"].timestamp()),
                -(record["last_activity_at"].timestamp()),
            )
        )
        return
    records.sort(
        key=lambda record: (
            STATUS_ORDER[record["status"]],
            -(record["last_activity_at"].timestamp()),
            -(record["started_at"].timestamp()),
        )
    )


def record_json(record: dict) -> dict:
    return {
        "id": record["id"],
        "title": record["title"],
        "thread_name": record["thread_name"],
        "preview": record["preview"],
        "cwd": record.get("cwd") or "",
        "repo": record.get("repo") or "",
        "agent_type": record.get("agent_type") or "",
        "agent_nickname": record.get("agent_nickname") or "",
        "status": record["status"],
        "source": record["source"],
        "age": record["age"],
        "live_age": record["live_age"],
        "started_at": record["started_at"].isoformat(),
        "last_activity_at": record["last_activity_at"].isoformat(),
        "path": str(record["path"]) if record.get("path") is not None else "",
        "recovery_kind": record.get("recovery_kind") or "",
    }


def render_column(record: dict, column: str, max_title: int) -> str:
    if column == "live":
        return record["live_age"]
    if column == "age":
        return record["age"]
    if column == "status":
        return record["status"]
    if column == "agent_type":
        return record.get("agent_type") or "-"
    if column == "id":
        return record["id"] or "-"
    if column == "cwd":
        return record.get("cwd") or "-"
    if column == "repo":
        return record.get("repo") or "-"
    if column == "path":
        return str(record["path"]) if record.get("path") is not None else "-"
    if column == "title":
        return truncate(record["title"], max_title)
    raise ValueError(f"Unknown column: {column}")


def print_table(
    records: list[dict],
    columns: tuple[str, ...],
    max_title: int,
    show_header: bool = True,
) -> None:
    rows = [[render_column(record, column, max_title) for column in columns] for record in records]
    header = [COLUMN_LABELS[column] for column in columns]
    widths = []
    for index, column in enumerate(columns):
        values = [row[index] for row in rows]
        if show_header:
            values.append(header[index])
        widths.append(max((len(value) for value in values), default=0))

    right_aligned = {"live", "age"}

    def format_row(row: list[str]) -> str:
        formatted = []
        for index, column in enumerate(columns):
            value = row[index]
            width = widths[index]
            if column in right_aligned:
                formatted.append(value.rjust(width))
            else:
                formatted.append(value.ljust(width) if column != "title" else value)
        return "  ".join(formatted).rstrip()

    if show_header:
        print(format_row(header))
    for row in rows:
        print(format_row(row))


def print_tsv(records: list[dict], columns: tuple[str, ...], max_title: int) -> None:
    for record in records:
        print(
            "\t".join(render_column(record, column, max_title) for column in columns)
        )


def find_session_by_id(source: str, session_id: str) -> Path | None:
    source_roots = build_source_roots(source)
    for _, path in iter_session_paths(source_roots):
        if extract_id_from_filename(path.name) == session_id:
            return path
    index_entries = load_session_index_entries(source_roots)
    for source_name, path in iter_session_paths(source_roots):
        if session_info(path, source_name, index_entries=index_entries)["id"] == session_id:
            return path
    return None


def index_only_session_by_id(source: str, session_id: str) -> dict | None:
    source_roots = build_source_roots(source)
    entry = load_session_index_entries(source_roots).get(session_id)
    if not entry:
        return None
    return build_index_only_record(session_id, entry)


def emit_recovery_payload(
    recovery_kind: str,
    session_id: str,
    title: str,
    cwd: str,
    repo: str,
    path: str,
    agent_type: str = "",
) -> dict:
    warning = {
        "zero_byte": "Session file is zero-byte; showing index-backed metadata only.",
        "metadata_empty": "Session file has no usable metadata; showing recovery metadata only.",
        "index_only": "Session file is missing; showing session_index-backed metadata only.",
    }.get(recovery_kind, "Showing recovery metadata only.")
    return {
        "type": "session_recovery",
        "payload": {
            "id": session_id,
            "title": title,
            "cwd": cwd,
            "repo": repo,
            "agent_type": agent_type,
            "path": path,
            "recovery_kind": recovery_kind,
            "warning": warning,
        },
    }


def fetch_session(path: Path, output_format: str, source: str = "all") -> int:
    source_roots = build_source_roots(source)
    index_entries = load_session_index_entries(source_roots)
    session_id = extract_id_from_filename(path.name)
    info = session_info(path, "live", index_entries=index_entries)
    if info.get("recovery_kind") == "zero_byte":
        fallback = emit_recovery_payload(
            "zero_byte",
            session_id,
            info.get("title") or "",
            info.get("cwd") or "",
            info.get("repo") or "",
            str(path),
            info.get("agent_type") or "",
        )
        if output_format == "jsonl":
            print(json.dumps(fallback, ensure_ascii=False))
            return 0
        print(json.dumps([fallback], ensure_ascii=False, indent=2))
        return 0

    if output_format == "jsonl":
        with open_session_text(path) as f:
            for line in f:
                print(line.rstrip("\n"))
        return 0

    payload: list[object] = []
    with open_session_text(path) as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                payload.append(json.loads(line))
            except Exception:
                payload.append({"_raw": line})
    print(json.dumps(payload, ensure_ascii=False, indent=2))
    return 0


def emit_stream_line(line: str, output_format: str) -> None:
    line = line.rstrip("\n")
    if output_format == "jsonl":
        print(line, flush=True)
        return
    raw = line.strip()
    if not raw:
        return
    try:
        obj = json.loads(raw)
    except Exception:
        obj = {"_raw": raw}
    print(json.dumps(obj, ensure_ascii=False), flush=True)


def follow_session(
    path: Path,
    output_format: str,
    since_start: bool,
    poll_interval: float,
) -> int:
    if path.name.endswith(".jsonl.gz") or path.name.endswith(".jsonl.zst"):
        print(
            "Streaming follow is supported only for live .jsonl files. "
            "Use `fetch` + polling for compressed sessions.",
            file=sys.stderr,
        )
        return 2
    if poll_interval <= 0:
        print("--poll-interval must be greater than 0.", file=sys.stderr)
        return 2

    try:
        with path.open("r", encoding="utf-8", errors="replace") as f:
            if not since_start:
                f.seek(0, os.SEEK_END)
            while True:
                line = f.readline()
                if line:
                    emit_stream_line(line, output_format)
                    continue
                time.sleep(poll_interval)
    except KeyboardInterrupt:
        return 0
    except OSError as exc:
        print(f"Failed to follow session file: {exc}", file=sys.stderr)
        return 1


def content_text(content: object) -> str:
    """Extract text blocks without inventing representations of attachments."""
    if isinstance(content, str):
        return content
    if not isinstance(content, list):
        return ""
    return "\n".join(block["text"] for block in content
                     if isinstance(block, dict) and isinstance(block.get("text"), str))


@contextmanager
def open_transcript_text(path: Path):
    # Unlike the live-follow reader, transcript must detect failed decompression.
    if not path.name.endswith(".jsonl.zst"):
        with open_session_text(path) as stream:
            yield stream
        return
    proc = subprocess.Popen(["zstd", "-dc", str(path)], stdout=subprocess.PIPE,
                            stderr=subprocess.PIPE, text=True, encoding="utf-8", errors="replace")
    try:
        assert proc.stdout is not None
        yield proc.stdout
        proc.stdout.close()
        stderr = proc.stderr.read() if proc.stderr else ""
        if proc.wait() != 0:
            raise OSError("zstd decompression failed: " + stderr.strip())
    finally:
        if proc.poll() is None:
            proc.kill()
            proc.wait()
        if proc.stdout:
            proc.stdout.close()
        if proc.stderr:
            proc.stderr.close()


def transcript(path: Path) -> tuple[list[dict], int]:
    """Return user events and conservative turn-level final-answer associations."""
    candidates = []
    finals: dict[str, list[dict]] = {}
    completions: dict[str, dict] = {}
    aborted: set[str] = set()
    current_turn = None
    malformed = 0
    with open_transcript_text(path) as stream:
        for line_number, line in enumerate(stream, 1):
            try:
                obj = json.loads(line)
                if not isinstance(obj, dict):
                    raise ValueError("not an object")
            except (ValueError, TypeError):
                malformed += 1
                continue
            payload = obj.get("payload") or {}
            if not isinstance(payload, dict):
                continue
            kind, event = obj.get("type"), payload.get("type")
            meta = payload.get("internal_chat_message_metadata_passthrough") or {}
            turn = payload.get("turn_id") or (meta.get("turn_id") if isinstance(meta, dict) else None)
            if event == "task_started" or kind == "turn_context":
                current_turn = turn or current_turn
            turn = turn or current_turn
            if event == "item_completed" and isinstance(payload.get("item"), dict):
                item = payload["item"]
                if item.get("type") == "UserMessage":
                    candidates.append((line_number, 0, item.get("id"), turn,
                                       content_text(item.get("content")), obj.get("timestamp")))
            elif kind == "event_msg" and event == "user_message":
                candidates.append((line_number, 1, payload.get("id"), turn,
                                   content_text(payload.get("message") or payload.get("content")), obj.get("timestamp")))
            elif kind == "response_item" and event == "message" and payload.get("role") == "user":
                # Only explicitly user-authored records: ambient context and instructions also have role=user.
                metadata = meta.get("content_item_metadata", []) if isinstance(meta, dict) else []
                if any(isinstance(m, dict) and (m.get("provenance") or {}).get("type") == "user" for m in metadata):
                    candidates.append((line_number, 2, payload.get("id"), turn,
                                       content_text(payload.get("content")), obj.get("timestamp")))
            elif (kind == "response_item" and event == "message" and payload.get("role") == "assistant"
                  and payload.get("phase") == "final_answer" and turn):
                finals.setdefault(turn, []).append({"id": payload.get("id") or f"line:{line_number}",
                                                    "text": content_text(payload.get("content")),
                                                    "timestamp": obj.get("timestamp")})
            elif kind == "event_msg" and event == "task_complete" and turn:
                completions[turn] = {"id": f"line:{line_number}", "text": payload.get("last_agent_message") or "",
                                     "timestamp": obj.get("timestamp")}
                current_turn = None
            elif kind == "event_msg" and event in ("turn_aborted", "task_failed", "task_aborted"):
                if turn:
                    aborted.add(turn)
                current_turn = None
    # The same message is frequently recorded twice in adjacent response/item events.
    # Prefer the UI item identifier; retain repeated identical submissions when they are not adjacent.
    selected = []
    for candidate in sorted(candidates):
        line, priority, ident, turn, text, timestamp = candidate
        duplicate = next((i for i in range(len(selected) - 1, -1, -1)
                          if line - selected[i][0] <= 3 and selected[i][3] == turn
                          and selected[i][4] == text and selected[i][1] != priority), None)
        if duplicate is not None:
            if priority < selected[duplicate][1]:
                selected[duplicate] = candidate
        else:
            selected.append(candidate)
    selected.sort()
    counts: dict[str, int] = {}
    for _, _, _, turn, _, _ in selected:
        if turn:
            counts[turn] = counts.get(turn, 0) + 1
    result = []
    for line, _, ident, turn, text, timestamp in selected:
        answers = finals.get(turn, []) if turn else []
        if not answers and turn in completions and completions[turn]["text"]:
            answers = [completions[turn]]
        if not turn:
            status = "unknown_turn"
        elif turn in aborted:
            status = "interrupted"
        elif not answers:
            status = "no_final"
        elif counts[turn] != 1 or len(answers) != 1:
            status = "ambiguous_shared_turn"
        else:
            status = "matched"
        result.append({"id": ident or f"line:{line}", "line": line, "timestamp": timestamp,
                       "turn_id": turn, "text": text, "association": status, "final_answers": answers})
    return result, malformed


def clip_agent_text(text: str, maximum: int | None) -> str:
    if maximum is None or len(text) <= maximum:
        return text
    return f"{text[:maximum]}\n[truncated: showing {maximum} of {len(text)} chars]"


def compact_transcript(records: list[dict], max_agent_chars: int | None = None) -> str:
    """Render user messages with only linked final-answer evidence."""
    blocks = []
    for record in records:
        status = record["association"]
        user_text = record["text"] or "[No extracted text; attachment may be present.]"
        blocks.append(f"---USER [{record['id']}; {status}]\n{user_text}")
        answers = record.get("final_answers", [])
        if status == "matched":
            for answer in answers:
                blocks.append("---AGENT\n" + clip_agent_text(answer["text"], max_agent_chars))
        elif status == "ambiguous_shared_turn":
            for index, answer in enumerate(answers, 1):
                blocks.append(
                    f"---AGENT [ambiguous_shared_turn; candidate {index}/{len(answers)}, not attributed to this request]\n"
                    + clip_agent_text(answer["text"], max_agent_chars)
                )
            if not answers:
                blocks.append("---AGENT [ambiguous_shared_turn; no final answer recorded]")
        elif status == "interrupted":
            if answers:
                for answer in answers:
                    blocks.append(
                        "---AGENT [interrupted; completion is unproven]\n"
                        + clip_agent_text(answer["text"], max_agent_chars)
                    )
            else:
                blocks.append("---AGENT [interrupted; no final answer recorded]")
        elif status == "no_final":
            blocks.append("---AGENT [no_final; no final answer recorded]")
        else:
            blocks.append("---AGENT [unknown_turn; cannot link a final answer]")
    return "\n\n".join(blocks)


def run_transcript(args: argparse.Namespace) -> int:
    path = find_session_by_id(args.source, args.session_id)
    if not path:
        print(f"Session id not found: {args.session_id}", file=sys.stderr)
        return 1
    try:
        records, malformed = transcript(path)
    except (OSError, EOFError, subprocess.SubprocessError) as exc:
        print(f"Failed to read session: {exc}", file=sys.stderr)
        return 1
    if malformed:
        print(f"Warning: skipped {malformed} malformed event(s).", file=sys.stderr)
    if args.max_agent_chars is not None and args.format != "compact":
        print("--max-agent-chars is supported only with --format compact.", file=sys.stderr)
        return 2
    if args.max_agent_chars is not None and args.max_agent_chars <= 0:
        print("--max-agent-chars must be greater than 0.", file=sys.stderr)
        return 2
    if args.message:
        ids = set(args.message)
        missing = ids - {record["id"] for record in records}
        if missing:
            print("Message id(s) not found: " + ", ".join(sorted(missing)), file=sys.stderr)
            return 2
        records = [record for record in records if record["id"] in ids]
    elif args.format != "compact":
        # Fast overview: finals are retrieved only when messages are selected.
        records = [{k: v for k, v in record.items() if k != "final_answers"} for record in records]
    if args.format == "compact":
        rendered = compact_transcript(records, args.max_agent_chars)
        if rendered:
            print(rendered)
    elif args.format == "json":
        print(json.dumps(records, ensure_ascii=False, indent=2))
    else:
        for record in records:
            print(json.dumps(record, ensure_ascii=False))
    return 0


APP_FAILURE_RE = re.compile(r"\b(?:fail(?:ed|ure)?|error|exception|timed? ?out|exit(?:ed)? with code)\b", re.IGNORECASE)


def redact_log_detail(value: object, max_length: int = 700) -> str:
    """Bound and redact local diagnostic text before displaying it."""
    text = str(value or "").replace("\x00", " ").replace("\n", " ").replace("\r", " ")
    text = re.sub(r"(?i)\bBearer\s+\S+", "Bearer [REDACTED]", text)
    text = re.sub(
        r"(?i)(\b(?:api[_-]?key|access[_-]?token|refresh[_-]?token|password|secret|authorization)\b\s*[=:]\s*)(?:\"[^\"]*\"|'[^']*'|[^\s,;}]+)",
        r"\1[REDACTED]",
        text,
    )
    text = re.sub(r"\b(?:sk|rk)-[A-Za-z0-9_-]{16,}\b", "[REDACTED]", text)
    if len(text) > max_length:
        text = text[: max_length - 1] + "…"
    return text


def capture_tmux_pane(pane_id: str, tail_lines: int) -> dict:
    """Capture a pane read-only; this function never sends keys or changes pane state."""
    try:
        result = subprocess.run(
            ["tmux", "capture-pane", "-p", "-J", "-t", pane_id, "-S", f"-{tail_lines}"],
            capture_output=True,
            text=True,
            encoding="utf-8",
            errors="replace",
            timeout=5,
            check=False,
        )
    except FileNotFoundError:
        return {"pane": pane_id, "error": "tmux executable not found", "lines": []}
    except subprocess.TimeoutExpired:
        return {"pane": pane_id, "error": "tmux capture timed out after 5 seconds", "lines": []}
    except OSError as exc:
        return {"pane": pane_id, "error": f"tmux capture failed: {exc}", "lines": []}
    if result.returncode != 0:
        return {
            "pane": pane_id,
            "error": redact_log_detail(result.stderr.strip() or f"tmux exited with code {result.returncode}", 300),
            "lines": [],
        }
    return {"pane": pane_id, "error": None, "lines": result.stdout.splitlines()[-tail_lines:]}


def read_native_hook_errors(log_dir: Path, session_id: str, since_epoch: float, limit: int) -> list[dict]:
    """Read OMX native-hook error records, if the dispatcher managed to persist them."""
    records = []
    if not log_dir.is_dir():
        return records
    for path in sorted(log_dir.glob("native-hook-*.jsonl")):
        try:
            with path.open("r", encoding="utf-8", errors="replace") as stream:
                for line_number, line in enumerate(stream, start=1):
                    try:
                        event = json.loads(line)
                    except (TypeError, ValueError):
                        continue
                    if not isinstance(event, dict):
                        continue
                    timestamp = parse_iso(str(event.get("timestamp") or ""))
                    if timestamp is None or timestamp.timestamp() < since_epoch:
                        continue
                    event_session = str(event.get("session_id") or "")
                    if event_session and event_session != session_id:
                        continue
                    if not (event.get("error") or "error" in str(event.get("type") or "").lower()):
                        continue
                    records.append({
                        "timestamp": timestamp.isoformat(),
                        "type": str(event.get("type") or ""),
                        "hook_event_name": str(event.get("hook_event_name") or "Unknown"),
                        "session_id": event_session or None,
                        "turn_id": event.get("turn_id"),
                        "error": redact_log_detail(event.get("error")),
                        "path": str(path),
                        "line": line_number,
                    })
        except OSError:
            continue
    records.sort(key=lambda record: record["timestamp"])
    return records[-limit:]


def read_small_json_file(path: Path, max_bytes: int = 4096) -> dict | None:
    """Read a bounded regular JSON file without following a final symlink."""
    fd = None
    try:
        before = path.lstat()
        if not stat.S_ISREG(before.st_mode) or before.st_size > max_bytes:
            return None
        fd = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
        with os.fdopen(fd, "r", encoding="utf-8", errors="replace") as stream:
            fd = None
            raw = stream.read(max_bytes + 1)
        if len(raw.encode("utf-8", errors="replace")) > max_bytes:
            return None
        value = json.loads(raw)
        return value if isinstance(value, dict) else None
    except (OSError, ValueError, json.JSONDecodeError):
        return None
    finally:
        if fd is not None:
            os.close(fd)


def process_liveness(pid: int) -> str:
    """Return a cautious local liveness classification for a numeric PID."""
    try:
        os.kill(pid, 0)
        return "alive"
    except ProcessLookupError:
        return "exited"
    except PermissionError:
        return "unknown"
    except (OSError, OverflowError, ValueError):
        return "unknown"


def read_omx_plugin_cache_pin_locks(codex_home: Path, session_id: str) -> dict:
    """Inspect OMX live-pin mutation locks read-only; never reclaim or remove them."""
    cache_base = codex_home / "plugins" / "cache" / "oh-my-codex-local" / "oh-my-codex"
    result = {"path": str(cache_base), "error": None, "records": []}
    try:
        cache_stat = cache_base.lstat()
    except OSError:
        result["error"] = "OMX plugin cache not found"
        return result
    if not stat.S_ISDIR(cache_stat.st_mode):
        result["error"] = "OMX plugin cache is not a real directory; skipped"
        return result

    session_hash = hashlib.sha256(session_id.strip().encode("utf-8")).hexdigest()
    try:
        versions = list(cache_base.iterdir())
    except OSError as exc:
        result["error"] = f"Unable to inspect OMX plugin cache: {redact_log_detail(exc, 240)}"
        return result

    for version_dir in versions[:200]:
        try:
            version_stat = version_dir.lstat()
        except OSError:
            continue
        if not stat.S_ISDIR(version_stat.st_mode):
            continue
        manifest = read_small_json_file(version_dir / ".codex-plugin" / "plugin.json", 16 * 1024)
        version = manifest.get("version") if manifest and manifest.get("name") == "oh-my-codex" else None
        if not isinstance(version, str) or version != version_dir.name:
            continue

        version_hash = hashlib.sha256(version.encode("utf-8")).hexdigest()[:24]
        lock_path = cache_base / f".omx-live-pin-{version_hash}.lock"
        try:
            lock_stat = lock_path.lstat()
        except OSError:
            continue
        if not stat.S_ISREG(lock_stat.st_mode) or lock_stat.st_size > 256:
            result["records"].append({
                "version": version,
                "status": "untrusted_lock_file",
                "link_count": lock_stat.st_nlink,
                "lock_mtime": datetime.fromtimestamp(lock_stat.st_mtime, tz=timezone.utc).isoformat(),
                "session_pin_present": False,
                "session_intent_present": False,
            })
            continue

        record = read_small_json_file(lock_path, 256)
        pid = record.get("pid") if record else None
        token = record.get("token") if record else None
        valid_record = (
            record is not None
            and record.get("version") == 1
            and isinstance(pid, int)
            and not isinstance(pid, bool)
            and pid > 0
            and record.get("operation") in {"pin", "retire"}
            and isinstance(token, str)
            and UUID_RE.fullmatch(token) is not None
        )
        owner_state = process_liveness(pid) if valid_record else "unknown"
        stage_path = lock_path.with_name(f"{lock_path.name}.stage-{pid}-{token}") if valid_record else None
        stage_matches = False
        if stage_path is not None:
            try:
                stage_stat = stage_path.lstat()
                stage_matches = (stage_stat.st_dev, stage_stat.st_ino) == (lock_stat.st_dev, lock_stat.st_ino)
            except OSError:
                pass

        reclaim_links = 0
        if valid_record and lock_stat.st_nlink > 1 and not stage_matches:
            try:
                for sibling in cache_base.iterdir():
                    if ".reclaim-" not in sibling.name:
                        continue
                    try:
                        sibling_stat = sibling.lstat()
                    except OSError:
                        continue
                    if (sibling_stat.st_dev, sibling_stat.st_ino) == (lock_stat.st_dev, lock_stat.st_ino):
                        reclaim_links += 1
            except OSError:
                pass

        pin_dir = cache_base / ".omx-pins" / version
        session_pin_present = False
        try:
            pin_dir_stat = pin_dir.lstat()
            if stat.S_ISDIR(pin_dir_stat.st_mode):
                for pin_path in list(pin_dir.glob("pin-*.json"))[:1000]:
                    pin_record = read_small_json_file(pin_path, 4096)
                    if pin_record and pin_record.get("sessionHash") == session_hash:
                        session_pin_present = True
                        break
        except OSError:
            pass
        pending_path = pin_dir / f".pending-{session_hash}.json"
        intent_path = cache_base / f".omx-live-pin-intent-{version_hash}-{session_hash}.json"
        session_intent_present = any(path.is_file() and not path.is_symlink() for path in (pending_path, intent_path))

        status = "unrecognized_lock"
        if valid_record and owner_state == "exited" and lock_stat.st_nlink == 2 and not stage_matches and reclaim_links:
            status = "orphaned_reclaim_hardlink"
        elif valid_record and owner_state == "exited" and lock_stat.st_nlink > 1 and not stage_matches:
            status = "orphaned_extra_hardlink"
        elif valid_record and owner_state == "exited":
            status = "stale_lock"
        elif valid_record and owner_state == "alive":
            status = "owner_alive"
        elif valid_record:
            status = "owner_liveness_unknown"

        result["records"].append({
            "version": version,
            "status": status,
            "operation": record.get("operation") if valid_record else None,
            "owner_pid": pid if valid_record else None,
            "owner_state": owner_state,
            "link_count": lock_stat.st_nlink,
            "expected_stage_present": stage_matches,
            "same_inode_reclaim_links": reclaim_links,
            "lock_mtime": datetime.fromtimestamp(lock_stat.st_mtime, tz=timezone.utc).isoformat(),
            "session_pin_present": session_pin_present,
            "session_intent_present": session_intent_present,
        })

    return result


def read_codex_app_log_errors(db_path: Path, session_id: str, since_epoch: float, limit: int) -> dict:
    """Read recent Codex app-server warnings/errors from logs_2.sqlite in read-only mode."""
    result = {"path": str(db_path), "error": None, "records": []}
    if not db_path.is_file():
        result["error"] = "Codex app log database not found"
        return result
    connection = None
    try:
        connection = sqlite3.connect(db_path.resolve().as_uri() + "?mode=ro", uri=True, timeout=0.25)
        connection.execute("PRAGMA query_only = ON")
        table = connection.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='logs'").fetchone()
        if not table:
            result["error"] = "logs table not found in Codex app log database"
            return result
        rows = connection.execute(
            """SELECT ts, level, target, module_path, line, thread_id, feedback_log_body
               FROM logs WHERE ts >= ? AND ts <= ?
               AND (upper(level) IN ('WARN', 'WARNING', 'ERROR') OR lower(target) LIKE '%hook%')
               ORDER BY ts DESC, ts_nanos DESC LIMIT 1000""",
            (since_epoch, time.time()),
        ).fetchall()
        for ts, level, target, module_path, line, thread_id, body in rows:
            level = str(level or "")
            target = str(target or "")
            body = str(body or "")
            thread_id = str(thread_id or "")
            hook_failure = "hook" in (target + " " + str(module_path or "") + " " + body).lower() and bool(APP_FAILURE_RE.search(body))
            if level.upper() not in {"WARN", "WARNING", "ERROR"} and not hook_failure:
                continue
            trace_ids = re.findall(
                r"(?:thread\.id|conversation\.id|thread_id|conversation_id)\s*=\s*([A-Za-z0-9._-]+)",
                body,
                re.IGNORECASE,
            )
            if thread_id and thread_id != session_id and session_id not in body:
                continue
            if not thread_id and trace_ids and session_id not in trace_ids:
                continue
            result["records"].append({
                "timestamp": datetime.fromtimestamp(float(ts), tz=timezone.utc).isoformat(),
                "level": level,
                "target": target,
                "module_path": str(module_path or ""),
                "line": line,
                "thread_id": thread_id or None,
                "scope": "session" if thread_id == session_id or session_id in body else "process-wide",
                "detail": redact_log_detail(body),
            })
        result["records"].sort(key=lambda record: record["timestamp"])
        result["records"] = result["records"][-limit:]
    except (OSError, sqlite3.Error, ValueError) as exc:
        result["error"] = f"Unable to read Codex app log database: {redact_log_detail(exc, 300)}"
    finally:
        if connection is not None:
            connection.close()
    return result


def render_diagnosis(report: dict) -> None:
    session = report["session"]
    print(f"Session: {session['id']}")
    print(f"Title: {session['title']}")
    print(f"CWD: {session['cwd'] or '(not recorded)'}")
    print(f"Transcript: {session['path']}")
    print(f"Window: since {report['since']} (UTC)")

    pane = report.get("tmux")
    if pane is not None:
        print(f"\n--- tmux pane {pane['pane']} (read-only capture) ---")
        if pane.get("error"):
            print(f"Capture unavailable: {pane['error']}")
        else:
            for line in pane["lines"]:
                print(line)
            print(f"Visible hook-failure markers: {report['summary']['visible_hook_failures']}")

    hook_errors = report["omx_native_hook_errors"]
    print("\n--- OMX native-hook error records ---")
    if hook_errors:
        for record in hook_errors:
            print(f"{record['timestamp']} {record['hook_event_name']} {record['type']}: {record['error']}")
    else:
        print("No matching native-hook error record was found in the selected .omx/logs directory.")

    app_logs = report["codex_app_logs"]
    print("\n--- Codex app-server warnings/errors ---")
    if app_logs.get("error"):
        print(f"Unavailable: {app_logs['error']} ({app_logs['path']})")
    elif app_logs["records"]:
        for record in app_logs["records"]:
            print(f"{record['timestamp']} {record['level']} {record['target']} [{record['scope']}]: {record['detail']}")
    else:
        print("No matching warnings/errors were found in the selected time window.")

    pin_locks = report["omx_plugin_cache_pin_locks"]
    print("\n--- OMX plugin-cache live-pin locks (read-only) ---")
    if pin_locks.get("error"):
        print(f"Unavailable: {pin_locks['error']} ({pin_locks['path']})")
    elif pin_locks["records"]:
        for record in pin_locks["records"]:
            print(
                f"version {record['version']}: {record['status']} "
                f"(pid={record['owner_pid']}, owner={record['owner_state']}, "
                f"nlink={record['link_count']}, session pin={'present' if record['session_pin_present'] else 'absent'}, "
                f"session intent={'present' if record['session_intent_present'] else 'absent'})"
            )
            if record["status"] == "orphaned_reclaim_hardlink":
                print(
                    "  Expected stage link is missing but an extra hard link remains under a .reclaim name. "
                    "This can block safe stale-lock recovery and required pin registration."
                )
                if not record["session_pin_present"] and record["session_intent_present"]:
                    print(
                        "  Strong candidate for this session's generic hook exit 1: the session has a pending "
                        "intent but no registered live pin. The native hook may exit before dispatcher logging."
                    )
    else:
        print("No OMX plugin-cache live-pin mutation lock was found for cached plugin versions.")
    print("No pin, lock, intent, or cache file was changed by this diagnosis.")

    print("\nInterpretation limit: the TUI message 'Hook failed / hook exited with code 1' proves only that a configured hook process returned non-zero; it does not identify the hook event or root cause by itself.")
    if report["summary"]["visible_hook_failures"] and not hook_errors:
        print("No OMX native-hook error record was captured. The failure may have occurred before OMX's dispatcher logged it, in another configured hook, or while the local error log was unavailable; this absence does not prove which.")


def run_diagnose(args: argparse.Namespace) -> int:
    if args.tail_lines < 1 or args.tail_lines > 1000:
        print("--tail-lines must be between 1 and 1000.", file=sys.stderr)
        return 2
    if args.limit < 1 or args.limit > 500:
        print("--limit must be between 1 and 500.", file=sys.stderr)
        return 2
    path = find_session_by_id(args.source, args.session_id)
    if not path:
        print(f"Session id not found: {args.session_id}", file=sys.stderr)
        return 1
    source_roots = build_source_roots(args.source)
    index_entries = load_session_index_entries(source_roots)
    info = session_info(path, args.source, index_entries=index_entries)
    cwd = args.cwd or info.get("cwd") or ""
    since_epoch = time.time() - args.since
    since = datetime.fromtimestamp(since_epoch, tz=timezone.utc).isoformat()
    tmux = capture_tmux_pane(args.tmux_pane, args.tail_lines) if args.tmux_pane else None
    pane_lines = tmux.get("lines", []) if tmux else []
    visible_failures = sum(len(re.findall(r"\bHook failed\b", line, re.IGNORECASE)) for line in pane_lines)
    log_dir = Path(args.omx_log_dir) if args.omx_log_dir else (Path(cwd) / ".omx" / "logs" if cwd else None)
    native_errors = read_native_hook_errors(log_dir, args.session_id, since_epoch, args.limit) if log_dir else []
    app_logs = read_codex_app_log_errors(Path(args.codex_log_db), args.session_id, since_epoch, args.limit)
    codex_home = Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex")
    pin_locks = read_omx_plugin_cache_pin_locks(codex_home, args.session_id)
    report = {
        "session": {
            "id": args.session_id,
            "title": info.get("title") or "(untitled session)",
            "cwd": cwd,
            "path": str(path),
            "agent_type": info.get("agent_type") or "",
        },
        "since": since,
        "tmux": tmux,
        "omx_native_hook_log_dir": str(log_dir) if log_dir else None,
        "omx_native_hook_errors": native_errors,
        "codex_app_logs": app_logs,
        "omx_plugin_cache_pin_locks": pin_locks,
        "summary": {
            "visible_hook_failures": visible_failures,
            "recorded_omx_native_hook_errors": len(native_errors),
            "codex_app_log_warnings_errors": len(app_logs["records"]),
            "omx_plugin_cache_pin_lock_records": len(pin_locks["records"]),
            "orphaned_omx_plugin_pin_locks": sum(
                record.get("status") == "orphaned_reclaim_hardlink"
                for record in pin_locks["records"]
            ),
        },
    }
    if args.format == "json":
        print(json.dumps(report, ensure_ascii=False, indent=2))
    else:
        render_diagnosis(report)
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="codex-session-scout",
        description="Inspect local Codex session logs and live rollout activity.",
    )
    parser.add_argument(
        "--version",
        action="version",
        version=f"%(prog)s {__version__}",
    )

    subparsers = parser.add_subparsers(dest="command", required=True)

    list_parser = subparsers.add_parser(
        "list",
        help="List sessions with explicit filtering, sorting, and column selection.",
    )
    list_parser.add_argument(
        "--source",
        choices=SOURCE_CHOICES,
        default="live",
        help="Read only live sessions or include archived sessions as well.",
    )
    list_parser.add_argument(
        "--query",
        help="Case-insensitive substring match against title, preview, or session id.",
    )
    list_parser.add_argument(
        "--regex",
        action="append",
        default=[],
        metavar="PATTERN",
        help="Case-insensitive regex match against title, preview, or session id. Repeatable.",
    )
    list_parser.add_argument(
        "--cwd",
        help="Case-insensitive substring match against session cwd/workdir metadata.",
    )
    list_parser.add_argument(
        "--cwd-regex",
        action="append",
        default=[],
        metavar="PATTERN",
        help="Case-insensitive regex match against session cwd/workdir metadata. Repeatable.",
    )
    list_parser.add_argument(
        "--repo",
        help="Case-insensitive substring match against derived repo metadata.",
    )
    list_parser.add_argument(
        "--repo-regex",
        action="append",
        default=[],
        metavar="PATTERN",
        help="Case-insensitive regex match against derived repo metadata. Repeatable.",
    )
    list_parser.add_argument(
        "--fulltext",
        help="Case-insensitive substring match against the full session event stream.",
    )
    list_parser.add_argument(
        "--fulltext-regex",
        action="append",
        default=[],
        metavar="PATTERN",
        help="Case-insensitive regex match against the full session event stream. Repeatable.",
    )
    list_parser.add_argument(
        "--status",
        action="append",
        choices=STATUS_CHOICES,
        default=[],
        help="Filter by derived status. Repeatable.",
    )
    list_parser.add_argument(
        "--active-within",
        type=parse_duration,
        metavar="DURATION",
        help="Only keep sessions with live activity within the given duration, for example 15m or 24h.",
    )
    list_parser.add_argument(
        "--running-window",
        type=parse_duration,
        default=parse_duration("5m"),
        metavar="DURATION",
        help="Duration used to classify a session as running. Default: 5m.",
    )
    list_parser.add_argument(
        "--include-untitled",
        action="store_true",
        help="Include sessions whose title could not be inferred.",
    )
    list_parser.add_argument(
        "--sort",
        choices=("live", "start"),
        default="live",
        help="Sort by live activity or start time.",
    )
    list_parser.add_argument(
        "--view",
        choices=tuple(VIEW_COLUMNS),
        default="ops",
        help="Column preset for table or TSV output.",
    )
    list_parser.add_argument(
        "--columns",
        type=parse_columns,
        metavar="COLUMN_LIST",
        help="Comma-separated column list that overrides --view.",
    )
    list_parser.add_argument(
        "--format",
        choices=("table", "tsv", "json"),
        default="table",
        help="Output format.",
    )
    list_parser.add_argument(
        "--limit",
        type=int,
        default=100,
        help="Maximum number of sessions to emit.",
    )
    list_parser.add_argument(
        "--max-title",
        type=int,
        default=96,
        help="Maximum rendered title length for table or TSV output. Session IDs are always printed in full.",
    )
    list_parser.add_argument(
        "--no-header",
        action="store_true",
        help="Do not print a header row for table output.",
    )
    list_parser.set_defaults(func=run_list)

    fetch_parser = subparsers.add_parser(
        "fetch",
        help="Emit the raw event stream for a single session id.",
    )
    fetch_parser.add_argument("session_id", help="Session id to fetch.")
    fetch_parser.add_argument(
        "--source",
        choices=SOURCE_CHOICES,
        default="all",
        help="Read only live sessions or include archived sessions as well.",
    )
    fetch_parser.add_argument(
        "--format",
        choices=("jsonl", "json"),
        default="jsonl",
        help="Output format for the fetched session.",
    )
    fetch_parser.set_defaults(func=run_fetch)

    diagnose_parser = subparsers.add_parser(
        "diagnose",
        help="Collect read-only session, hook-log, Codex app-log, and optional tmux evidence.",
    )
    diagnose_parser.add_argument("session_id", help="Full session id to correlate with local diagnostics.")
    diagnose_parser.add_argument(
        "--source", choices=SOURCE_CHOICES, default="all",
        help="Read only live sessions or include archived sessions as well.",
    )
    diagnose_parser.add_argument(
        "--since", type=parse_duration, default=parse_duration("30m"), metavar="DURATION",
        help="Include local error logs from this time window, e.g. 10m or 2h. Default: 30m.",
    )
    diagnose_parser.add_argument(
        "--tmux-pane", metavar="PANE",
        help="Explicitly capture a tmux pane read-only (for example %%0); no keys are sent.",
    )
    diagnose_parser.add_argument(
        "--tail-lines", type=int, default=100,
        help="Maximum tmux pane tail to capture when --tmux-pane is set. Default: 100.",
    )
    diagnose_parser.add_argument(
        "--cwd", help="Override the session cwd when locating the project's .omx/logs directory.",
    )
    diagnose_parser.add_argument(
        "--omx-log-dir", help="Override the directory containing native-hook-*.jsonl diagnostics.",
    )
    diagnose_parser.add_argument(
        "--codex-log-db", type=Path, default=DEFAULT_CODEX_LOG_DB,
        help="Read-only Codex app log database path. Default: CODEX_HOME/logs_2.sqlite.",
    )
    diagnose_parser.add_argument(
        "--limit", type=int, default=100,
        help="Maximum matching native-hook and Codex app log records to show (1-500). Default: 100.",
    )
    diagnose_parser.add_argument("--format", choices=("text", "json"), default="text")
    diagnose_parser.set_defaults(func=run_diagnose)

    transcript_parser = subparsers.add_parser(
        "transcript", help="List user messages and retrieve selected turn-level final answers.")
    transcript_parser.add_argument("session_id", help="Session id to inspect.")
    transcript_parser.add_argument("--source", choices=SOURCE_CHOICES, default="all")
    transcript_parser.add_argument("--message", action="append", default=[], metavar="ID",
                                   help="Select a message ID; repeat to select multiple messages.")
    transcript_parser.add_argument("--format", choices=("jsonl", "json", "compact"), default="jsonl")
    transcript_parser.add_argument("--max-agent-chars", type=int,
                                   help="Clip each rendered final answer to this many characters (compact format only).")
    transcript_parser.set_defaults(func=run_transcript)

    follow_parser = subparsers.add_parser(
        "follow",
        help="Stream new events for a session id (tail -f style).",
    )
    follow_parser.add_argument("session_id", help="Session id to follow.")
    follow_parser.add_argument(
        "--source",
        choices=SOURCE_CHOICES,
        default="live",
        help="Read only live sessions or include archived sessions as well.",
    )
    follow_parser.add_argument(
        "--format",
        choices=("jsonl", "json"),
        default="jsonl",
        help="Output format for streamed events.",
    )
    follow_parser.add_argument(
        "--since-start",
        action="store_true",
        help="Stream from the beginning of the file instead of only new events.",
    )
    follow_parser.add_argument(
        "--poll-interval",
        type=float,
        default=0.25,
        metavar="SECONDS",
        help="Polling interval for new lines. Default: 0.25 seconds.",
    )
    follow_parser.set_defaults(func=run_follow)
    return parser


def run_list(args: argparse.Namespace) -> int:
    if args.limit < 0:
        print("--limit must be zero or greater.", file=sys.stderr)
        return 2
    if args.max_title < 0:
        print("--max-title must be zero or greater.", file=sys.stderr)
        return 2

    regexes = []
    for raw in args.regex:
        try:
            regexes.append(re.compile(raw, re.IGNORECASE))
        except re.error as exc:
            print(f"Invalid regex pattern {raw!r}: {exc}", file=sys.stderr)
            return 2
    fulltext_regexes = []
    for raw in args.fulltext_regex:
        try:
            fulltext_regexes.append(re.compile(raw, re.IGNORECASE))
        except re.error as exc:
            print(f"Invalid fulltext regex pattern {raw!r}: {exc}", file=sys.stderr)
            return 2
    cwd_regexes = []
    for raw in args.cwd_regex:
        try:
            cwd_regexes.append(re.compile(raw, re.IGNORECASE))
        except re.error as exc:
            print(f"Invalid cwd regex pattern {raw!r}: {exc}", file=sys.stderr)
            return 2
    repo_regexes = []
    for raw in args.repo_regex:
        try:
            repo_regexes.append(re.compile(raw, re.IGNORECASE))
        except re.error as exc:
            print(f"Invalid repo regex pattern {raw!r}: {exc}", file=sys.stderr)
            return 2

    now = datetime.now(timezone.utc)
    status_filter = set(args.status) if args.status else None
    records = collect_sessions(
        source=args.source,
        include_untitled=args.include_untitled,
        query=args.query,
        regexes=regexes,
        cwd_query=args.cwd,
        cwd_regexes=cwd_regexes,
        repo_query=args.repo,
        repo_regexes=repo_regexes,
        fulltext_query=args.fulltext,
        fulltext_regexes=fulltext_regexes,
        now=now,
        running_window_seconds=args.running_window,
        status_filter=status_filter,
        active_within_seconds=args.active_within,
    )

    if args.status:
        allowed = set(args.status)
        records = [record for record in records if record["status"] in allowed]
    if args.active_within is not None:
        records = [
            record
            for record in records
            if (now - record["last_activity_at"]).total_seconds() <= args.active_within
        ]

    sort_records(records, args.sort)
    records = records[: args.limit]

    if args.format == "json":
        print(json.dumps([record_json(record) for record in records], ensure_ascii=False, indent=2))
        return 0

    columns = args.columns or VIEW_COLUMNS[args.view]
    if args.format == "tsv":
        print_tsv(records, columns, args.max_title)
        return 0

    print_table(records, columns, args.max_title, show_header=not args.no_header)
    return 0


def run_fetch(args: argparse.Namespace) -> int:
    path = find_session_by_id(args.source, args.session_id)
    if path:
        return fetch_session(path, args.format, source=args.source)
    record = index_only_session_by_id(args.source, args.session_id)
    if not record:
        print(f"Session id not found: {args.session_id}", file=sys.stderr)
        return 1
    fallback = emit_recovery_payload(
        "index_only",
        record.get("id") or args.session_id,
        record.get("title") or "",
        record.get("cwd") or "",
        record.get("repo") or "",
        "",
        record.get("agent_type") or "",
    )
    if args.format == "jsonl":
        print(json.dumps(fallback, ensure_ascii=False))
        return 0
    print(json.dumps([fallback], ensure_ascii=False, indent=2))
    return 0


def run_follow(args: argparse.Namespace) -> int:
    path = find_session_by_id(args.source, args.session_id)
    if not path:
        print(f"Session id not found: {args.session_id}", file=sys.stderr)
        return 1
    return follow_session(
        path=path,
        output_format=args.format,
        since_start=args.since_start,
        poll_interval=args.poll_interval,
    )


def exit_for_broken_stdout_pipe() -> int:
    try:
        devnull_fd = os.open(os.devnull, os.O_WRONLY)
    except OSError:
        return 0
    try:
        os.dup2(devnull_fd, sys.stdout.fileno())
    except OSError:
        pass
    finally:
        os.close(devnull_fd)
    return 0


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    try:
        return args.func(args)
    except BrokenPipeError:
        return exit_for_broken_stdout_pipe()


if __name__ == "__main__":
    raise SystemExit(main())
